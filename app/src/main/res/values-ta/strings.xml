    <string name="onboarding_title_1">ஒரு டோஸையும் தவறவிடாதீர்கள்</string>
    <string name="onboarding_body_1">இணையம் இல்லாவிட்டாலும் சரியான நேரத்தில் Medicare உங்களுக்கு நினைவூட்டும்.</string>
