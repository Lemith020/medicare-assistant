    <string name="app_name">Medicare</string>

    <string name="onboarding_title_1">ஒரு டோஸையும் தவறவிடாதீர்கள்</string>
    <string name="onboarding_body_1">இணையம் இல்லாவிட்டாலும் சரியான நேரத்தில் Medicare உங்களுக்கு நினைவூட்டும்.</string>
    <string name="onboarding_desc_1">ஒரு மருந்து காப்ஸ்யூல்</string>
    <string name="onboarding_title_2">அனைவருக்கும் புரியும் நினைவூட்டல்கள்</string>
    <string name="onboarding_body_2">உரத்த அலாரம், வலுவான அதிர்வு மற்றும் ஃபிளாஷ் ஒளி மூலம் எந்த டோஸும் தவறாது.</string>
    <string name="onboarding_desc_2">ஒலிக்கும் அலாரம் கடிகாரம்</string>
    <string name="onboarding_title_3">தொடங்கலாம்</string>
    <string name="onboarding_body_3">உங்கள் மருந்துகளை ஒருமுறை சேர்த்தால் போதும், மீதியை Medicare பார்த்துக் கொள்ளும்.</string>
    <string name="onboarding_desc_3">சரிபார்ப்பு குறியுடன் இதயம்</string>
